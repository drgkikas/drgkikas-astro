---
const { currentLocale } = Astro;
const locale = (currentLocale || 'el') as 'el' | 'en' | 'it';

const translations = {
  el: {
    announcementTitle: "Κλείστε ραντεβού μέσω WhatsApp",
    announcementSub: "Στείλτε μας μήνυμα στο 211 850 0016 και η Ψηφιακή Γραμματεία θα σας καθοδηγήσει στη διαδικασία κράτησης.",
    floatingLine1: "Κλείστε ραντεβού",
    floatingLine2: "μέσω WhatsApp",
    phoneDisplay: "211 850 0016",
    prefilledText: "Καλησπέρα, θα ήθελα να κλείσω ραντεβού.",
    closeAria: "Κλείσιμο ειδοποίησης",
    floatingAria: "Επικοινωνία στο WhatsApp για κράτηση ραντεβού",
  },
  en: {
    announcementTitle: "Book an appointment via WhatsApp",
    announcementSub: "Message us on 211 850 0016 and our automated booking assistant will guide you through the process.",
    floatingLine1: "Book an appointment",
    floatingLine2: "via WhatsApp",
    phoneDisplay: "211 850 0016",
    prefilledText: "Hello, I would like to book an appointment.",
    closeAria: "Dismiss notification",
    floatingAria: "Contact via WhatsApp to book an appointment",
  },
  it: {
    announcementTitle: "Prenota un appuntamento tramite WhatsApp",
    announcementSub: "Scrivici su WhatsApp al 211 850 0016 e il nostro assistente automatico ti guiderà nella prenotazione.",
    floatingLine1: "Prenota un appuntamento",
    floatingLine2: "via WhatsApp",
    phoneDisplay: "211 850 0016",
    prefilledText: "Salve, vorrei prenotare un appuntamento.",
    closeAria: "Chiudi notifica",
    floatingAria: "Contatta su WhatsApp per prenotare un appuntamento",
  }
};

const t = translations[locale] || translations.el;
const waUrl = `https://wa.me/302118500016?text=${encodeURIComponent(t.prefilledText)}`;
---

<!-- Inline script to set bar dismissal state before paint -> ZERO layout shift -->
<script is:inline>
  if (localStorage.getItem('wa_announcement_dismissed') === '1') {
    document.documentElement.classList.add('wa-bar-dismissed');
  }
</script>

<style is:global>
  :root {
    --wa-bar-height: 44px;
  }
  @media (min-width: 768px) {
    :root {
      --wa-bar-height: 40px;
    }
  }
  html.wa-bar-dismissed {
    --wa-bar-height: 0px !important;
  }
  /* Offset main header down when announcement bar is active */
  #main-header {
    top: var(--wa-bar-height) !important;
    transition: top 0.3s ease;
  }
  /* Ensure wa-announcement-bar is hidden when wa-bar-dismissed is present */
  html.wa-bar-dismissed #wa-announcement-bar {
    display: none !important;
  }
</style>

<!-- Top Announcement Bar -->
<div 
  id="wa-announcement-bar"
  class="fixed top-0 left-0 w-full z-[60] bg-gradient-to-r from-[#074e47] via-[#075E54] to-[#128C7E] text-white shadow-md transition-all duration-300 overflow-hidden font-sans border-b border-emerald-400/20"
>
  <div class="max-w-7xl mx-auto px-3 sm:px-6 py-2 flex items-center justify-between gap-2 text-xs sm:text-sm">
    <a 
      href={waUrl} 
      target="_blank" 
      rel="noopener noreferrer"
      class="flex-1 flex items-center justify-center gap-2 sm:gap-3 hover:opacity-95 transition-opacity text-center min-w-0"
      aria-label={t.announcementTitle}
    >
      <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-[#25D366] flex items-center justify-center shrink-0 shadow-sm border border-white/20">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
      </div>
      <div class="truncate">
        <span class="font-bold sm:inline block tracking-tight">{t.announcementTitle}: </span>
        <span class="opacity-95 font-normal sm:inline block truncate">{t.announcementSub}</span>
      </div>
    </a>
    <button 
      id="wa-dismiss-btn"
      class="p-1.5 hover:bg-white/10 rounded-full transition-colors shrink-0 text-white/80 hover:text-white"
      aria-label={t.closeAria}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>

<!-- Floating WhatsApp CTA (Bottom Left to avoid collision with AIA Chatbot on Bottom Right) -->
<div 
  id="wa-floating-cta"
  class="fixed bottom-5 left-4 md:left-6 md:bottom-6 z-40 font-sans pointer-events-auto transition-all duration-300"
>
  <a 
    href={waUrl} 
    target="_blank" 
    rel="noopener noreferrer"
    aria-label={t.floatingAria}
    class="group flex items-center gap-3 bg-white hover:bg-emerald-50/90 text-slate-800 p-2.5 sm:p-3 rounded-2xl shadow-xl hover:shadow-2xl border border-slate-200/90 hover:border-emerald-500/50 transition-all duration-300 active:scale-95"
  >
    <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-[#25D366] text-white flex items-center justify-center shrink-0 shadow-md group-hover:scale-105 transition-transform">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-current text-white" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
    </div>
    
    <div class="flex flex-col text-left leading-tight pr-1">
      <span class="text-[11px] sm:text-xs font-bold text-slate-900 group-hover:text-emerald-800 transition-colors">
        {t.floatingLine1}
      </span>
      <span class="text-[10px] sm:text-[11px] text-slate-500 font-medium">
        {t.floatingLine2}
      </span>
      <span class="text-[11px] sm:text-xs font-semibold text-emerald-700 mt-0.5">
        {t.phoneDisplay}
      </span>
    </div>
  </a>
</div>

<script>
  const dismissBtn = document.getElementById('wa-dismiss-btn');
  dismissBtn?.addEventListener('click', () => {
    localStorage.setItem('wa_announcement_dismissed', '1');
    document.documentElement.classList.add('wa-bar-dismissed');
  });
</script>
