---
const { currentLocale } = Astro;

const t = {
  el: {
    message: "Χρησιμοποιούμε cookies και την ετικέτα Google για στατιστικά επισκεψιμότητας και μέτρηση της απόδοσης διαφημιστικών καμπανιών. Πριν από την αποδοχή δεν αποθηκεύονται cookies Analytics ή διαφήμισης· αποστέλλονται μόνο περιορισμένα σήματα μέτρησης χωρίς cookies.",
    accept: "Αποδοχή",
    decline: "Απόρριψη"
  },
  en: {
    message: "We use cookies and the Google tag for traffic statistics and measuring ad campaign performance. Prior to acceptance, no Analytics or advertising cookies are stored; only limited measurement signals without cookies are sent.",
    accept: "Accept",
    decline: "Decline"
  },
  it: {
    message: "Utilizziamo i cookie e il tag Google per le statistiche sul traffico e la misurazione delle prestazioni delle campagne pubblicitarie. Prima dell'accettazione, non vengono memorizzati cookie analitici o pubblicitari; vengono inviati solo segnali di misurazione limitati senza cookie.",
    accept: "Accetta",
    decline: "Rifiuta"
  }
};

const labels = t[currentLocale] || t.el;
---

<div 
  id="cookie-consent-banner" 
  class="fixed bottom-0 left-0 right-0 z-50 p-4 bg-slate-900/95 backdrop-blur-md text-white border-t border-slate-800 shadow-xl transition-all duration-300"
  style="display: none;"
  aria-label="Cookie Consent Banner"
>
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-xs sm:text-sm text-slate-200 text-center sm:text-left leading-relaxed">
      {labels.message}
    </p>
    <div class="flex items-center gap-3 shrink-0">
      <button 
        id="cookie-consent-decline" 
        type="button"
        class="px-4 py-2 text-xs sm:text-sm font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 hover:text-white rounded-lg transition-colors cursor-pointer"
      >
        {labels.decline}
      </button>
      <button 
        id="cookie-consent-accept" 
        type="button"
        class="px-4 py-2 text-xs sm:text-sm font-medium text-white bg-blue-600 hover:bg-blue-500 rounded-lg transition-colors shadow-sm cursor-pointer"
      >
        {labels.accept}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var GA_ID = 'G-7E6N24PFYT';

    function getCleanPageLocation() {
      try {
        var url = new URL(window.location.href);
        var searchParams = url.searchParams;
        var debugParams = new URLSearchParams();
        
        ['gtm_debug', '_dbg', 'gtm_auth', 'gtm_preview', 'tag_assistant_id'].forEach(function(param) {
          if (searchParams.has(param)) {
            debugParams.set(param, searchParams.get(param));
          }
        });
        
        var queryString = debugParams.toString();
        return url.origin + url.pathname + (queryString ? '?' + queryString : '');
      } catch(e) {
        return window.location.origin + window.location.pathname;
      }
    }

    // 1. Synchronous initialization of dataLayer and gtag
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () {
      window.dataLayer.push(arguments);
    };

    // 2. Default consent configuration for Advanced Consent Mode v2
    window.gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      wait_for_update: 500
    });

    window.gtag('set', 'ads_data_redaction', true);

    // 3. Saved consent state check before gtag('config')
    var savedConsent = localStorage.getItem('ga_cookie_consent');
    if (savedConsent === 'granted') {
      window.gtag('consent', 'update', {
        analytics_storage: 'granted',
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'denied'
      });
    }

    // 4. GA4 configuration & gtag.js loading (Advanced Consent Mode v2)
    function initGA4() {
      if (window.__ga_loaded) return;
      window.__ga_loaded = true;

      window.gtag('js', new Date());

      var configParams = {
        page_location: getCleanPageLocation(),
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
        anonymize_ip: true
      };

      try {
        var searchParams = new URLSearchParams(window.location.search);
        if (searchParams.has('_dbg')) {
          configParams._dbg = searchParams.get('_dbg') || true;
        }
      } catch(e) {}

      window.gtag('config', GA_ID, configParams);

      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(script);
    }

    initGA4();

    // 5. Banner UI handlers
    function initBannerUI() {
      var banner = document.getElementById('cookie-consent-banner');
      var acceptBtn = document.getElementById('cookie-consent-accept');
      var declineBtn = document.getElementById('cookie-consent-decline');

      var currentConsent = localStorage.getItem('ga_cookie_consent');
      if (currentConsent !== 'granted' && currentConsent !== 'denied') {
        if (banner) banner.style.display = 'block';
      }

      if (acceptBtn) {
        acceptBtn.addEventListener('click', function() {
          localStorage.setItem('ga_cookie_consent', 'granted');
          if (banner) banner.style.display = 'none';
          window.gtag('consent', 'update', {
            analytics_storage: 'granted',
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'denied'
          });
        });
      }

      if (declineBtn) {
        declineBtn.addEventListener('click', function() {
          localStorage.setItem('ga_cookie_consent', 'denied');
          if (banner) banner.style.display = 'none';
          window.gtag('consent', 'update', {
            analytics_storage: 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied'
          });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBannerUI);
    } else {
      initBannerUI();
    }
  })();
</script>
