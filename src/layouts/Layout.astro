---
import '../styles/global.css';
import ChatWidget from '../components/AIA/ChatWidget.astro';
import WhatsAppCta from '../components/UI/WhatsAppCta.astro';

/* Layout: Added meta tags and SEO optimization */

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
  schema?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
}

const { 
  title, 
  description = "Πασχάλης Γκίκας — Ψυχίατρος στην Αθήνα. Εξειδικευμένες υπηρεσίες rTMS, Φαρμακογονιδιωματικής και Ψυχοθεραπείας στο Smart CNS Center.", 
  canonicalURL,
  image = "/images/dr-gkikas-portrait.jpg",
  schema,
  ogTitle,
  ogDescription,
  ogType = "website"
} = Astro.props;
const rawCanonical = canonicalURL ?? new URL(Astro.url.pathname, 'https://drgkikas.com').href;
const canonical = (rawCanonical.endsWith('/') && rawCanonical !== 'https://drgkikas.com/') 
  ? rawCanonical.slice(0, -1) 
  : rawCanonical;
const socialImageURL = new URL(image, 'https://drgkikas.com').href;

// Dynamic Hreflang Logic
const pathname = Astro.url.pathname;
let basePath = pathname;
if (basePath.startsWith('/en/')) {
  basePath = basePath.slice(3);
} else if (basePath === '/en') {
  basePath = '/';
} else if (basePath.startsWith('/it/')) {
  basePath = basePath.slice(3);
} else if (basePath === '/it') {
  basePath = '/';
}

// Ensure basePath starts with /
if (!basePath.startsWith('/')) {
  basePath = '/' + basePath;
}
// Strip trailing slash
if (basePath.endsWith('/') && basePath !== '/') {
  basePath = basePath.slice(0, -1);
}

// Determine localized equivalents
let elHref = `https://drgkikas.com${basePath}`;
let enHref = `https://drgkikas.com/en${basePath}`;
let itHref = `https://drgkikas.com/it${basePath}`;

if (basePath === '/') {
  elHref = 'https://drgkikas.com';
  enHref = 'https://drgkikas.com/en';
  itHref = 'https://drgkikas.com/it';
}

if (basePath === '/epikoinonia' || basePath === '/contact' || basePath === '/contatti') {
  elHref = 'https://drgkikas.com/epikoinonia';
  enHref = 'https://drgkikas.com/en/contact';
  itHref = 'https://drgkikas.com/it/contatti';
}

// Strip trailing slashes on final equivalents just in case
if (elHref.endsWith('/') && elHref !== 'https://drgkikas.com') elHref = elHref.slice(0, -1);
if (enHref.endsWith('/') && enHref !== 'https://drgkikas.com/en') enHref = enHref.slice(0, -1);
if (itHref.endsWith('/') && itHref !== 'https://drgkikas.com/it') itHref = itHref.slice(0, -1);

// Limit hreflang tags only to multilingual pages
const isMultilingual = 
  basePath === '/' || 
  basePath.startsWith('/rtms') || 
  basePath.startsWith('/diataraxes') || 
  basePath.startsWith('/ypiresies') || 
  basePath === '/iatros' || 
  basePath === '/epikoinonia' || basePath === '/contact' || basePath === '/contatti' ||
  basePath.startsWith('/privacy-policy');
---

<!doctype html>
<html lang={Astro.currentLocale || 'el'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- Font Preloading Optimization -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    
    {isMultilingual && (
      <>
        <link rel="alternate" hreflang="el" href={elHref} />
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="it" href={itHref} />
      </>
    )}
    
    <!-- OpenGraph Tags -->
    <meta property="og:title" content={ogTitle || title} />
    <meta property="og:description" content={ogDescription || description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Πασχάλης Γκίκας | Ψυχίατρος Αθήνα" />
    <meta property="og:locale" content={Astro.currentLocale === 'en' ? 'en_US' : Astro.currentLocale === 'it' ? 'it_IT' : 'el_GR'} />

    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    {Astro.url.hostname.includes('pages.dev') && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    {schema && <script type="application/ld+json" set:html={schema} />}
    <!-- [Ahrefs Analytics Script] - Safely removable -->
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="hKDhDXLoXZvN5sqL6+g1ew" async></script>
    <!-- [/Ahrefs Analytics Script] -->
  </head>
  <body class="flex flex-col min-h-screen">
    <WhatsAppCta />
    <slot />
    <ChatWidget />
  </body>
</html>
