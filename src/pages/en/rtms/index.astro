  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://drgkikas.com/en/rtms/#webpage",
      "url": "https://drgkikas.com/en/rtms",
      "name": "rTMS Athens | Depression, OCD & Cocaine Addiction | drGkikas",
      "description": "rTMS therapy is non-invasive, requires no anesthesia, and is used for treatment-resistant depression, OCD, and cocaine addiction. See how it is applied in Athens, its duration, safety, side effects, and evaluation process.",
      "inLanguage": "en",
      "mainEntity": {
        "@id": "https://drgkikas.com/en/rtms/#service"
      }
    },
    {
