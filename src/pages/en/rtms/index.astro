          }
        },
        {
          "@type": "Question",
          "name": "When do you see results from rTMS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Response time varies from patient to patient. Some notice changes within the first few weeks, while in other cases, response is evaluated after completing most of the protocol."
          }
        },
        {
          "@type": "Question",
          "name": "Can rTMS be combined with medication?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In many cases, rTMS can be administered alongside pharmacological treatment. The decision is made individually by the psychiatrist, based on the diagnosis, history, tolerance, and goals."
          }
        }
      ]
    }
