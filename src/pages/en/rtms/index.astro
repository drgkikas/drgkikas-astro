---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/UI/Header.astro';
import Footer from '../../../components/UI/Footer.astro';

const allRtmsPages = await getCollection('rtms', ({ id }) => {
  return id.startsWith('en/');
});

// Categorize pages based on their directory/id
const corePages = allRtmsPages.filter(p => p.id.startsWith('en/core/')).sort((a,b)=> (a.data.order||0) - (b.data.order||0));
const endixeisPages = allRtmsPages.filter(p => p.id.startsWith('en/endixeis/')).sort((a,b)=> (a.data.order||0) - (b.data.order||0));
const posLeitourgeiPages = allRtmsPages.filter(p => p.id.startsWith('en/pos-leitourgei/')).sort((a,b)=> (a.data.order||0) - (b.data.order||0));
const schema = JSON.stringify({
