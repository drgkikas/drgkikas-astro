---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/UI/Header.astro';
import Footer from '../../components/UI/Footer.astro';

const allRtmsPages = await getCollection('rtms', ({ id }) => {
  return !id.startsWith('en/') && !id.startsWith('it/');
});

// Categorize pages based on their directory/id
const corePages = allRtmsPages.filter(p => p.id.startsWith('core/'));
const endixeisPages = allRtmsPages.filter(p => p.id.startsWith('endixeis/'));
const posLeitourgeiPages = allRtmsPages.filter(p => p.id.startsWith('pos-leitourgei/'));
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://drgkikas.com/rtms/#webpage",
      "url": "https://drgkikas.com/rtms",
      "name": "rTMS Αθήνα | Κατάθλιψη, OCD & Εξάρτηση από Κοκαΐνη | drGkikas",
      "description": "rTMS στην Αθήνα για κατάθλιψη και OCD, με εξατομικευμένα πρωτόκολλα νευροτροποποίησης. Δείτε ενδείξεις, ασφάλεια, διαδικασία και κόστος.",
      "inLanguage": "el",
      "mainEntity": {
        "@id": "https://drgkikas.com/rtms/#service"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://drgkikas.com/rtms/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Αρχική",
          "item": "https://drgkikas.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "rTMS",
          "item": "https://drgkikas.com/rtms"
        }
      ]
    },
    {
      "@type": "Physician",
      "@id": "https://drgkikas.com/#physician",
      "name": "Πασχάλης Γκίκας",
      "alternateName": "drGkikas",
      "medicalSpecialty": "Psychiatry",
      "image": "https://drgkikas.com/images/dr-gkikas-portrait.jpg",
      "logo": "https://drgkikas.com/images/dr-gkikas-portrait.jpg",
      "url": "https://drgkikas.com/",
      "availableLanguage": ["Greek", "English", "Italian"]
    },
    {
      "@type": "MedicalBusiness",
      "@id": "https://drgkikas.com/#clinic",
      "name": "Smart CNS Center",
      "url": "https://drgkikas.com/",
      "image": "https://drgkikas.com/images/dr-gkikas-portrait.jpg",
      "logo": "https://drgkikas.com/images/dr-gkikas-portrait.jpg",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Ξενοφώντος 15Α",
        "addressLocality": "Αθήνα",
        "addressRegion": "Αττική",
        "postalCode": "10557",
        "addressCountry": "GR"
      },
      "areaServed": "Athens, Greece"
    },
    {
      "@type": "Service",
      "@id": "https://drgkikas.com/rtms/#service",
      "name": "rTMS στην Αθήνα",
      "alternateName": "Επαναληπτικός Διακρανιακός Μαγνητικός Ερεθισμός",
      "provider": {
        "@id": "https://drgkikas.com/#physician"
      },
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": "Athens, Greece"
      },
      "serviceType": "rTMS, iTBS, neuromodulation",
      "url": "https://drgkikas.com/rtms",
      "description": "rTMS στην Αθήνα για κατάθλιψη και OCD, με εξατομικευμένα πρωτόκολλα νευροτροποποίησης. Δείτε ενδείξεις, ασφάλεια, διαδικασία και κόστος."
    },
    {
      "@type": "MedicalTherapy",
      "@id": "https://drgkikas.com/rtms/#medicaltherapy",
      "name": "rTMS treatment",
      "alternateName": "Repetitive Transcranial Magnetic Stimulation",
      "url": "https://drgkikas.com/rtms",
      "provider": {
        "@id": "https://drgkikas.com/#physician"
      },
      "description": "Μη επεμβατική θεραπεία νευροτροποποίησης.",
      "clinicalPharmacology": "Transcranial magnetic stimulation",
      "indication": [
        {
          "@type": "MedicalIndication",
          "name": "Treatment-resistant depression"
        },
        {
          "@type": "MedicalIndication",
          "name": "Obsessive-compulsive disorder"
        },
        {
          "@type": "MedicalIndication",
          "name": "Cocaine addiction / Cocaine use disorder"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://drgkikas.com/rtms/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Τι είναι το rTMS;",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Το rTMS είναι μη επεμβατική θεραπεία νευροτροποποίησης που χρησιμοποιεί μαγνητικούς παλμούς για στοχευμένη διέγερση συγκεκριμένων περιοχών του εγκεφάλου. Δεν απαιτεί νάρκωση και ο ασθενής παραμένει ξύπνιος κατά τη διάρκεια της συνεδρίας."
          }
        },
        {
          "@type": "Question",
          "name": "Ποια είναι η διαφορά rTMS και ECT;",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Το rTMS δεν είναι ηλεκτροσπασμοθεραπεία. Δεν προκαλεί σπασμό, δεν απαιτεί γενική αναισθησία και δεν συνδέεται με την ίδια διαδικασία ή το ίδιο προφίλ γνωσιακών ανεπιθύμητων ενεργειών που μπορεί να έχει το ECT."
          }
        },
        {
          "@type": "Question",
          "name": "Ποια είναι η διαφορά rTMS και iTBS;",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Το iTBS είναι ειδικό, συντομότερο πρωτόκολλο μαγνητικής διέγερσης που ανήκει στην οικογένεια των TMS θεραπειών. Η επιλογή rTMS ή iTBS γίνεται ανάλογα με την ένδειξη, το ιστορικό, την ανεκτικότητα και την κλινική αξιολόγηση."
          }
        },
        {
          "@type": "Question",
          "name": "Πότε προτείνεται το rTMS στην κατάθλιψη;",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Το rTMS εξετάζεται κυρίως όταν η κατάθλιψη δεν έχει ανταποκριθεί επαρκώς σε προηγούμενες θεραπευτικές προσπάθειες ή όταν η φαρμακευτική αγωγή προκαλεί προβλήματα ανεκτικότητας. Η ένδειξη τίθεται μετά από ψυχιατρική αξιολόγηση και έλεγχο του ιστορικού θεραπείας."
          }
        },
        {
          "@type": "Question",
          "name": "Είναι ασφαλές το rTMS;",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Το rTMS είναι συνήθως καλά ανεκτό όταν εφαρμόζεται με κατάλληλα πρωτόκολλα ασφαλείας. Οι συχνότερες ενοχλήσεις είναι τοπική δυσφορία στο σημείο εφαρμογής ή πονοκέφαλος, ενώ οι σοβαρές ανεπιθύμητες ενέργειες είναι σπάνιες."
          }
        },
        {
          "@type": "Question",
          "name": "Πόσες συνεδρίες rTMS χρειάζονται;",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ο αριθμός συνεδριών εξαρτάται από την ένδειξη, το πρωτόκολλο και την ανταπόκριση του ασθενούς. Συνήθως απαιτείται σειρά επαναλαμβανόμενων συνεδριών, με διάρκεια που καθορίζεται εξατομικευμένα."
          }
        },
        {
          "@type": "Question",
          "name": "Πότε φαίνεται αποτέλεσμα από το rTMS;",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ο χρόνος ανταπόκρισης διαφέρει από ασθενή σε ασθενή. Κάποιοι παρατηρούν αλλαγές μέσα στις πρώτες εβδομάδες, ενώ σε άλλες περιπτώσεις η ανταπόκριση αξιολογείται μετά την ολοκλήρωση μεγαλύτερου μέρους του πρωτοκόλλου."
          }
        },
        {
          "@type": "Question",
          "name": "Μπορεί το rTMS να συνδυαστεί με φαρμακευτική αγωγή;",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Σε πολλές περιπτώσεις το rTMS μπορεί να εφαρμοστεί παράλληλα με φαρμακευτική αγωγή. Η απόφαση λαμβάνεται εξατομικευμένα από τον ψυχίατρο, με βάση τη διάγνωση, το ιστορικό, την ανεκτικότητα και τους θεραπευτικούς στόχους."
          }
        }
      ]
    }
  ]
});
---

<Layout 
  title="rTMS Αθήνα | Κατάθλιψη, OCD & Εξάρτηση από Κοκαΐνη | drGkikas" 
  description="rTMS στην Αθήνα για κατάθλιψη και OCD, με εξατομικευμένα πρωτόκολλα νευροτροποποίησης. Δείτε ενδείξεις, ασφάλεια, διαδικασία και κόστος."
  canonicalURL="https://drgkikas.com/rtms"
  ogTitle="rTMS Αθήνα | Κατάθλιψη, OCD & Εξάρτηση από Κοκαΐνη"
  ogDescription="rTMS στην Αθήνα για κατάθλιψη και OCD, με εξατομικευμένα πρωτόκολλα νευροτροποποίησης. Δείτε ενδείξεις, ασφάλεια, διαδικασία και κόστος."
  ogType="website"
  schema={schema}
>
  <Header />

  <main class="pt-24 pb-20 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Opening Block -->
      <section class="bg-white rounded-3xl p-8 md:p-14 shadow-sm border border-slate-100 relative overflow-hidden mb-12">
        <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-red-600 to-red-900"></div>
        
        <div class="max-w-4xl">
          <span class="text-red-700 font-bold tracking-widest text-xs uppercase mb-4 block">Topical Hub: rTMS / iTBS</span>
          <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 mb-8 tracking-tight leading-tight">
            rTMS: Επαναληπτικός Διακρανιακός Μαγνητικός Ερεθισμός στην Αθήνα
          </h1>
          
          <div class="prose prose-xl prose-slate mb-10 text-slate-700 leading-relaxed font-light">
            <p>
              Ο Επαναληπτικός Διακρανιακός Μαγνητικός Ερεθισμός (rTMS) είναι μια μη επεμβατική θεραπεία που χρησιμοποιεί μαγνητικούς παλμούς για να διεγείρει στοχευμένα συγκεκριμένες περιοχές του εγκεφάλου. Δεν απαιτεί νάρκωση, είναι καλά ανεκτή και ο ασθενής μπορεί συνήθως να επιστρέψει άμεσα στις καθημερινές του δραστηριότητες. Στο Smart CNS Center στην Αθήνα, εφαρμόζονται εξατομικευμένα πρωτόκολλα rTMS και iTBS, κυρίως για κατάθλιψη, ανθεκτική κατάθλιψη, ιδεοψυχαναγκαστική διαταραχή (OCD), καθώς και ως συμπληρωματική θεραπευτική προσέγγιση στη διαταραχή χρήσης κοκαΐνης, με στόχο μεταξύ άλλων τη μείωση του craving, μετά από ψυχιατρική αξιολόγηση.
            </p>
            <p class="text-xs text-slate-500 mt-6 font-normal">
              Ιατρική επιμέλεια: Πασχάλης Γκίκας, Ψυχίατρος
            </p>
          </div>

          <!-- Quick Answer Block - AI Optimization -->
          <div class="bg-red-50/80 border border-red-100 rounded-2xl p-6 md:p-8">
            <h2 class="text-lg font-bold text-red-900 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
              rTMS σε 30 δευτερόλεπτα:
            </h2>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-y-3 gap-x-8 text-slate-800 font-medium list-none p-0 m-0">
              <li class="flex items-start gap-2"><span class="text-red-500">•</span> Χωρίς νάρκωση ή φάρμακα</li>
              <li class="flex items-start gap-2"><span class="text-red-500">•</span> Διάρκεια συνεδρίας: 3 - 40 λεπτά</li>
              <li class="flex items-start gap-2"><span class="text-red-500">•</span> Άμεση επιστροφή στις καθημερινές δραστηριότητες</li>
              <li class="flex items-start gap-2"><span class="text-red-500">•</span> Εγκεκριμένο για Ανθεκτική Κατάθλιψη & OCD</li>
              <li class="flex items-start gap-2"><span class="text-red-500">•</span> Δεν προκαλεί συστηματικές παρενέργειες (οι τοπικές είναι παροδικές)</li>
              <li class="flex items-start gap-2"><span class="text-red-500">•</span> Εφαρμόζεται κλινικά εδώ και 20+ χρόνια</li>
            </ul>
          </div>
      </section>

      <!-- Clinical Relevance Section -->
      <section class="bg-white rounded-3xl p-8 md:p-14 shadow-sm border border-slate-100 relative overflow-hidden mb-12">
        <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-red-600 to-red-900"></div>
        <div class="max-w-4xl">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-6">
            Πότε έχει νόημα να σκεφτεί κάποιος το rTMS;
          </h2>
          <p class="text-slate-700 leading-relaxed text-lg font-light">
            Το rTMS έχει κυρίως νόημα όταν τα συμπτώματα κατάθλιψης ή OCD παραμένουν παρά την κατάλληλη θεραπευτική προσπάθεια, όταν η φαρμακευτική αγωγή δεν έχει δώσει επαρκές αποτέλεσμα ή όταν οι παρενέργειες περιορίζουν την ανεκτικότητα. Δεν αντικαθιστά αυτόματα την ψυχιατρική παρακολούθηση ή τη φαρμακευτική θεραπεία· αξιολογείται ως πιθανή επιλογή μετά από κλινική εκτίμηση, ιστορικό προηγούμενων θεραπειών και επιλογή κατάλληλου πρωτοκόλλου.
          </p>
        </div>
      </section>

      <!-- Bridging Section -->
      <section class="bg-white rounded-3xl p-8 md:p-12 border border-slate-100 shadow-sm mb-12">
        <div class="max-w-4xl">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">
            Οδηγός rTMS: Θεραπεία, Ενδείξεις και Διαδικασία
          </h2>
          <p class="text-slate-600 leading-relaxed text-lg font-light">
            Η σελίδα αυτή λειτουργεί ως κεντρικός οδηγός για το rTMS και το iTBS. Παρακάτω θα βρείτε οργανωμένες ενότητες για τη διαδικασία, την ασφάλεια, το κόστος, τις βασικές ενδείξεις και το επιστημονικό υπόβαθρο της θεραπείας. Κάθε ενότητα οδηγεί σε αναλυτική σελίδα, ώστε ο αναγνώστης να μπορεί να ξεκινήσει από τη βασική εικόνα και να προχωρήσει σε πιο εξειδικευμένες πληροφορίες.
          </p>
        </div>
      </section>

      <!-- Thematic Path 1: Core -->
      <section class="mb-20">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-8 flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-red-100 text-red-700 flex items-center justify-center font-black">1</span>
          Βασικές Πληροφορίες & Διαδικασία
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {corePages.map(page => (
            <a href={`/rtms/${page.id}`} class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md hover:border-red-400 transition-all group block">
              <h3 class="text-lg font-bold text-red-900 mb-3 group-hover:text-red-600 leading-tight">{page.data.title}</h3>
              <p class="text-sm text-slate-500 line-clamp-2 leading-relaxed">{page.data.description}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- Thematic Path 2: Indications -->
      <section class="mb-20">
        <div class="flex items-baseline justify-between mb-8 border-b border-slate-200 pb-4">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-red-100 text-red-700 flex items-center justify-center font-black">2</span>
            Κλινικές Ενδείξεις: Για ποιους;
          </h2>
          <span class="hidden md:block text-slate-400 text-sm font-medium">Εγκεκριμένες & Κλινικές Εφαρμογές</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {endixeisPages.map(page => (
            <a href={`/rtms/${page.id}`} class="relative group bg-white p-8 rounded-3xl shadow-sm border border-slate-100 hover:shadow-xl hover:shadow-red-900/5 transition-all block min-h-[160px]">
              <div class="absolute top-6 right-8 text-red-100 group-hover:text-red-200 transition-colors">
                <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-red-700 pr-12">{page.data.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed line-clamp-3">{page.data.description}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- Thematic Path 3: Mechanics -->
      <section class="mb-16">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-8 flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-red-100 text-red-700 flex items-center justify-center font-black">3</span>
          Επιστημονικό Υπόβαθρο: Πώς λειτουργεί;
        </h2>
        <div class="bg-white rounded-3xl p-4 md:p-8 border border-slate-100 shadow-sm">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {posLeitourgeiPages.map(page => (
              <a href={`/rtms/${page.id}`} class="flex items-center gap-4 p-4 rounded-xl hover:bg-red-50 transition-colors border border-transparent hover:border-red-100 group">
                <div class="w-2 h-2 rounded-full bg-red-400 group-hover:scale-150 transition-transform"></div>
                <span class="text-slate-700 font-bold group-hover:text-red-800">{page.data.title}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="mb-8 bg-white rounded-3xl p-8 md:p-14 shadow-sm border border-slate-100">
        <h2 class="text-3xl font-extrabold text-slate-900 mb-8 tracking-tight">
          Συχνές ερωτήσεις για το rTMS
        </h2>
        
        <div class="space-y-4 max-w-4xl">
          <details class="group border border-slate-100 rounded-2xl bg-slate-50/50 p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-300">
            <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-700 transition-colors">
                Τι είναι το rTMS;
              </h3>
              <span class="ml-1.5 flex-shrink-0 rounded-full bg-white p-1.5 text-slate-900 shadow-sm transition-transform duration-300 group-open:-rotate-180">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 leading-relaxed text-slate-700 font-light">
              <p>
                Το rTMS είναι μη επεμβατική θεραπεία νευροτροποποίησης που χρησιμοποιεί μαγνητικούς παλμούς για στοχευμένη διέγερση συγκεκριμένων περιοχών του εγκεφάλου. Δεν απαιτεί νάρκωση και ο ασθενής παραμένει ξύπνιος κατά τη διάρκεια της συνεδρίας.
              </p>
              <p class="mt-3">
                <a href="/rtms/core/ti-einai" class="inline-flex items-center text-sm font-semibold text-red-600 hover:text-red-700 gap-1">
                  Μάθετε περισσότερα: Τι είναι το rTMS και το iTBS &rarr;
                </a>
              </p>
            </div>
          </details>

          <details class="group border border-slate-100 rounded-2xl bg-slate-50/50 p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-300">
            <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-700 transition-colors">
