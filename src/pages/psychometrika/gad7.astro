---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/UI/Header.astro';
import Footer from '../../components/UI/Footer.astro';
import Gad7 from '../../components/Tests/Gad7';

const canonicalURL = "https://drgkikas.com/psychometrika/gad7";

const schemaBundle = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalWebPage",
      "@id": `${canonicalURL}#webpage`,
      "name": "GAD-7 — Κλίμακα Γενικευμένου Άγχους & Τεστ",
      "description": "Διαδραστικό ερωτηματολόγιο αυτοαναφοράς για την αξιολόγηση συμπτωμάτων άγχους (GAD-7). Δεν υποκαθιστά την κλινική αξιολόγηση από ειδικό.",
      "url": canonicalURL,
      "inLanguage": "el",
      "mainEntity": {
        "@id": `${canonicalURL}#application`
      }
    },
    {
      "@type": "WebApplication",
      "@id": `${canonicalURL}#application`,
      "name": "GAD-7",
      "url": canonicalURL,
      "description": "Διαδραστικό ερωτηματολόγιο 7 ερωτήσεων για συμπτώματα γενικευμένου άγχους.",
      "inLanguage": "el",
      "applicationCategory": "HealthApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript"
    }
  ]
});
---

<Layout
  title="GAD-7 — Κλίμακα Γενικευμένου Άγχους & Τεστ"
  description="Αξιολογήστε τα επίπεδα άγχους με το GAD-7. Άμεσα αποτελέσματα και ερμηνεία στο email σας."
  canonicalURL={canonicalURL}
  schema={schemaBundle}
>
  <Header />
  <main class="min-h-screen bg-slate-50 py-24">
    <h1 class="sr-only">GAD-7 — Κλίμακα Γενικευμένου Άγχους</h1>
    <div class="max-w-2xl mx-auto px-4 sm:px-6 mt-12">

      <div class="mb-8">
        <a href="/psychometrika" class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-blue-600 transition-colors mb-6">
          ← Όλα τα ερωτηματολόγια
        </a>
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-700">
          <strong>Σημείωση:</strong> Αυτό το ερωτηματολόγιο δεν αποτελεί διαγνωστικό εργαλείο και δεν υποκαθιστά την κλινική αξιολόγηση από ειδικό.
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
        <Gad7 client:load />
      </div>

    </div>
  </main>
  <Footer />
</Layout>
