---
export const prerender = true;
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/UI/Header.astro';
import Footer from '../../components/UI/Footer.astro';

const services = await getCollection('services', ({ id }) => !id.startsWith('en/') && !id.startsWith('it/'));

const canonicalURL = "https://drgkikas.com/ypiresies";

const schemaBundle = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalURL}#webpage`,
      "url": canonicalURL,
      "name": "Υπηρεσίες Ψυχιατρικής",
      "description": "Ανακαλύψτε το εύρος των εξειδικευμένων ψυχιατρικών υπηρεσιών μας στην Αθήνα: Από τη νευροτροποποίηση rTMS και τη φαρμακογονιδιωματική PGx μέχρι τη Γνωσιακή Ψυχοθεραπεία CBT.",
      "inLanguage": "el",
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": services.map((s, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": s.data.title,
          "url": s.id.toLowerCase() === 'rtms' ? 'https://drgkikas.com/rtms' : `https://drgkikas.com/ypiresies/${s.id.toLowerCase()}`
        }))
      }
    }
  ]
});
---

<Layout
  title="Υπηρεσίες Ψυχιατρικής"
  description="Ανακαλύψτε το εύρος των εξειδικευμένων ψυχιατρικών υπηρεσιών μας στην Αθήνα: Από τη νευροτροποποίηση rTMS και τη φαρμακογονιδιωματική PGx μέχρι τη Γνωσιακή Ψυχοθεραπεία CBT."
  canonicalURL={canonicalURL}
  schema={schemaBundle}
>
  <Header />
  <main class="py-24 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
      <h1 class="text-4xl font-bold text-slate-900 mb-4">Υπηρεσίες</h1>
      <p class="text-lg text-slate-600 mb-12">Σαφής θεραπευτική κατεύθυνση, εξατομικευμένη για κάθε πρόβλημα.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map(service => (
          <a href={service.id.toLowerCase() === 'rtms' ? '/rtms' : `/ypiresies/${service.id.toLowerCase()}`} class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md hover:border-blue-400 transition-all group block">
            <h2 class="text-xl font-bold text-blue-900 mb-3 group-hover:text-blue-700">{service.data.title} &rarr;</h2>
            <p class="text-slate-600 line-clamp-2">{service.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
