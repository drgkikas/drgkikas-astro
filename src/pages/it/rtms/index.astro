---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/UI/Header.astro';
import Footer from '../../../components/UI/Footer.astro';

const allRtmsPages = await getCollection('rtms', ({ id }) => {
  return id.startsWith('it/');
});

// Categorize pages based on their directory/id
const corePages = allRtmsPages.filter(p => p.id.startsWith('it/core/')).sort((a,b)=> (a.data.order||0) - (b.data.order||0));
const endixeisPages = allRtmsPages.filter(p => p.id.startsWith('it/endixeis/')).sort((a,b)=> (a.data.order||0) - (b.data.order||0));
const posLeitourgeiPages = allRtmsPages.filter(p => p.id.startsWith('it/pos-leitourgei/')).sort((a,b)=> (a.data.order||0) - (b.data.order||0));
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://drgkikas.com/it/rtms/#webpage",
      "url": "https://drgkikas.com/it/rtms",
      "name": "rTMS Atene | Depressione, DOC e Dipendenza da Cocaina | drGkikas",
      "description": "La terapia rTMS è non invasiva, senza anestesia ed è utilizzata per la depressione resistente, il DOC e la dipendenza da cocaina. Scopri come viene applicata ad Atene, la durata, la sicurezza, gli effetti collaterali e il processo di valutazione.",
      "inLanguage": "it",
      "mainEntity": {
        "@id": "https://drgkikas.com/it/rtms/#service"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://drgkikas.com/it/rtms/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://drgkikas.com/it/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "rTMS",
          "item": "https://drgkikas.com/it/rtms"
        }
      ]
    },
    {
      "@type": "Physician",
      "@id": "https://drgkikas.com/#physician",
      "name": "Paschalis Gkikas",
      "alternateName": "drGkikas",
      "medicalSpecialty": "Psychiatry",
      "image": "https://drgkikas.com/images/dr-gkikas-portrait.jpg",
      "logo": "https://drgkikas.com/images/dr-gkikas-portrait.jpg",
      "url": "https://drgkikas.com/it/",
      "availableLanguage": ["Greek", "English", "Italian"]
    },
    {
      "@type": "MedicalBusiness",
      "@id": "https://drgkikas.com/#clinic",
      "name": "Smart CNS Center",
      "url": "https://drgkikas.com/it/",
      "image": "https://drgkikas.com/images/dr-gkikas-portrait.jpg",
      "logo": "https://drgkikas.com/images/dr-gkikas-portrait.jpg",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Via Xenofontos 15A",
        "addressLocality": "Atene",
        "addressRegion": "Attica",
        "postalCode": "10557",
        "addressCountry": "GR"
      },
      "areaServed": "Athens, Greece"
    },
    {
      "@type": "Service",
      "@id": "https://drgkikas.com/it/rtms/#service",
      "name": "rTMS ad Atene",
      "alternateName": "Stimolazione Magnetica Transcranica Ripetitiva",
      "provider": {
        "@id": "https://drgkikas.com/#physician"
      },
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": "Athens, Greece"
      },
      "serviceType": "rTMS, iTBS, neuromodulation",
      "url": "https://drgkikas.com/it/rtms",
      "description": "Terapia di neuromodulazione non invasiva ad Atene per depressione, depressione resistente, disturbo ossessivo-compulsivo (DOC) e trattamento della dipendenza da cocaina."
    },
    {
      "@type": "MedicalTherapy",
      "@id": "https://drgkikas.com/it/rtms/#medicaltherapy",
      "name": "rTMS treatment",
      "alternateName": "Repetitive Transcranial Magnetic Stimulation",
      "url": "https://drgkikas.com/it/rtms",
      "provider": {
        "@id": "https://drgkikas.com/#physician"
      },
      "description": "Terapia di neuromodulazione non invasiva.",
      "clinicalPharmacology": "Transcranial magnetic stimulation",
      "indication": [
        {
          "@type": "MedicalIndication",
          "name": "Treatment-resistant depression"
        },
        {
          "@type": "MedicalIndication",
          "name": "Obsessive-compulsive disorder"
        },
        {
          "@type": "MedicalIndication",
          "name": "Cocaine addiction / Cocaine use disorder"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://drgkikas.com/it/rtms/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Cos'è la rTMS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La rTMS è una terapia di neuromodulazione non invasiva che utilizza impulsi magnetici per stimolare in modo mirato aree specifiche del cervello. Non richiede anestesia e il paziente rimane cosciente durante la sessione."
          }
        },
        {
          "@type": "Question",
          "name": "Qual è la differenza tra rTMS ed ECT?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La rTMS non è l'elettroshock (terapia elettroconvulsivante). Non provoca convulsioni, non richiede anestesia generale e non è associata alla stessa procedura o al profilo di effetti collaterali cognitivi che l'ECT può presentare."
          }
        },
        {
          "@type": "Question",
          "name": "Qual è la differenza tra rTMS e iTBS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'iTBS è un protocollo di stimolazione magnetica specifico e più breve, appartenente alla famiglia delle terapie TMS. La scelta tra rTMS e iTBS viene effettuata in base all'indicazione, all'anamnesi, alla tollerabilità e alla valutazione clinica."
          }
        },
        {
          "@type": "Question",
          "name": "Quando si consiglia la rTMS per la depressione?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La rTMS viene presa in considerazione principalmente quando la depressione non ha risposto adeguatamente ai precedenti tentativi di trattamento o quando la terapia farmacologica causa problemi di tollerabilità. L'indicazione viene stabilita a seguito di una valutazione psichiatrica e di un esame dell'anamnesi clinica."
          }
        },
        {
          "@type": "Question",
          "name": "La rTMS è sicura?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La rTMS è generalmente ben tollerata se applicata seguendo gli opportuni protocolli di sicurezza. I fastidi più comuni sono un temporaneo disagio locale a livello dello scalpo nel sito di applicazione o mal di testa, mentre gli eventi avversi gravi sono rari."
          }
        },
        {
          "@type": "Question",
          "name": "Quante sedute di rTMS sono necessarie?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il numero di sedute dipende dall'indicazione, dal protocollo e dalla risposta del paziente. Di solito è necessaria una serie di sessioni ripetute, con una durata stabilita su base individuale."
          }
        },
        {
          "@type": "Question",
          "name": "Quando si vedono i risultati della rTMS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "I tempi di risposta variano da paziente a paziente. Alcuni notano miglioramenti già nelle prime settimane, mentre in altri casi la risposta viene valutata dopo aver completato la maggior parte del protocollo."
          }
        },
        {
          "@type": "Question",
          "name": "La rTMS può essere combinata con la terapia farmacologica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In molti casi, la rTMS può essere applicata in parallelo alla terapia farmacologica. La decisione viene presa individualmente dallo psichiatra, in base alla diagnosi, all'anamnesi, alla tollerabilità e agli obiettivi terapeutici."
          }
        }
      ]
    }
  ]
});
---

<Layout 
  title="rTMS Atene | Depressione, DOC e Dipendenza da Cocaina | drGkikas" 
  description="La terapia rTMS è non invasiva, senza anestesia ed è utilizzata per la depressione resistente, il DOC e la dipendenza da cocaina. Scopri come viene applicata ad Atene, la durata, la sicurezza, gli effetti collaterali e il processo di valutazione."
  canonicalURL="https://drgkikas.com/it/rtms"
  ogTitle="rTMS Atene | Depressione, DOC e Dipendenza da Cocaina"
  ogDescription="Terapia di neuromodulazione non invasiva ad Atene per depressione resistente, DOC e dipendenza da cocaina."
  ogType="website"
  schema={schema}
>
  <Header />

  <main class="pt-24 pb-20 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Opening Block -->
      <section class="bg-white rounded-3xl p-8 md:p-14 shadow-sm border border-slate-100 relative overflow-hidden mb-12">
        <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-red-600 to-red-900"></div>
        
        <div class="max-w-4xl">
          <span class="text-red-700 font-bold tracking-widest text-xs uppercase mb-4 block">Hub Tematico: rTMS / iTBS</span>
          <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 mb-8 tracking-tight leading-tight">
            rTMS: Stimolazione Magnetica Transcranica Ripetitiva ad Atene
          </h1>
          
          <div class="prose prose-xl prose-slate mb-10 text-slate-700 leading-relaxed font-light">
            <p>
              La Stimolazione Magnetica Transcranica Ripetitiva (rTMS) è un trattamento non invasivo che utilizza impulsi magnetici per stimolare selettivamente specifiche aree del cervello. Non richiede anestesia, è ben tollerato e il paziente può solitamente tornare immediatamente alle sue attività quotidiane. Presso lo Smart CNS Center di Atene, si applicano protocolli rTMS e iTBS personalizzati, principalmente per depressione, depressione resistente, disturbo ossessivo-compulsivo (DOC) e per il trattamento della dipendenza da cocaina previa valutazione psichiatrica.
            </p>
          </div>

          <!-- Quick Answer Block - AI Optimization -->
          <div class="bg-red-50/80 border border-red-100 rounded-2xl p-6 md:p-8">
            <h2 class="text-lg font-bold text-red-900 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
              rTMS in 30 secondi:
            </h2>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-y-3 gap-x-8 text-slate-800 font-medium list-none p-0 m-0">
              <li class="flex items-start gap-2"><span class="text-red-500">•</span> Senza anestesia o farmaci sistemici</li>
              <li class="flex items-start gap-2"><span class="text-red-500">•</span> Durata della sessione: 3 - 40 minuti</li>
              <li class="flex items-start gap-2"><span class="text-red-500">•</span> Ritorno immediato alle attività quotidiane</li>
              <li class="flex items-start gap-2"><span class="text-red-500">•</span> Approvato per Depressione Resistente e DOC</li>
              <li class="flex items-start gap-2"><span class="text-red-500">•</span> Alti tassi di remissione senza effetti collaterali sistemici</li>
              <li class="flex items-start gap-2"><span class="text-red-500">•</span> Applicato clinicamente da oltre 20 anni</li>
            </ul>
          </div>
      </section>

      <!-- Clinical Relevance Section -->
      <section class="bg-white rounded-3xl p-8 md:p-14 shadow-sm border border-slate-100 relative overflow-hidden mb-12">
        <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-red-600 to-red-900"></div>
        <div class="max-w-4xl">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-6">
            Quando ha senso prendere in considerazione la rTMS?
          </h2>
          <p class="text-slate-700 leading-relaxed text-lg font-light">
            La rTMS ha senso soprattutto quando i sintomi della depressione o del DOC persistono nonostante un adeguato sforzo terapeutico, quando la terapia farmacologica non ha fornito risultati sufficienti o quando gli effetti collaterali ne limitano la tollerabilità. Non sostituisce automaticamente il monitoraggio psichiatrico o il trattamento farmacologico; viene valutata come possibile opzione dopo una valutazione clinica, l'anamnesi dei trattamenti precedenti e la selezione del protocollo appropriato.
          </p>
        </div>
      </section>

      <!-- Bridging Section -->
      <section class="bg-white rounded-3xl p-8 md:p-12 border border-slate-100 shadow-sm mb-12">
        <div class="max-w-4xl">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">
            Come utilizzare questa guida
          </h2>
          <p class="text-slate-600 leading-relaxed text-lg font-light">
            Questa pagina funge da guida centrale per rTMS e iTBS. Di seguito troverete sezioni organizzate che trattano la procedura, la sicurezza, il costo, le indicazioni chiave e il background scientifico della terapia. Ciascuna sezione rimanda a una sottopagina dettagliata, consentendo al lettore di iniziare con una panoramica di base e procedere verso informazioni più specialistiche.
          </p>
        </div>
      </section>

      <!-- Thematic Path 1: Core -->
      <section class="mb-20">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-8 flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-red-100 text-red-700 flex items-center justify-center font-black">1</span>
          Informazioni di Base & Procedura
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {corePages.map(page => (
            <a href={`/it/rtms/${page.id.replace('it/', '')}`} class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md hover:border-red-400 transition-all group block">
              <h3 class="text-lg font-bold text-red-900 mb-3 group-hover:text-red-600 leading-tight">{page.data.title}</h3>
              <p class="text-sm text-slate-500 line-clamp-2 leading-relaxed">{page.data.description}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- Thematic Path 2: Indications -->
      <section class="mb-20">
        <div class="flex items-baseline justify-between mb-8 border-b border-slate-200 pb-4">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-red-100 text-red-700 flex items-center justify-center font-black">2</span>
            Indicazioni Cliniche: Per chi?
          </h2>
          <span class="hidden md:block text-slate-400 text-sm font-medium">Applicazioni Cliniche e Approvate</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {endixeisPages.map(page => (
            <a href={`/it/rtms/${page.id.replace('it/', '')}`} class="relative group bg-white p-8 rounded-3xl shadow-sm border border-slate-100 hover:shadow-xl hover:shadow-red-900/5 transition-all block min-h-[160px]">
              <div class="absolute top-6 right-8 text-red-100 group-hover:text-red-200 transition-colors">
                <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-red-700 pr-12">{page.data.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed line-clamp-3">{page.data.description}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- Thematic Path 3: Mechanics -->
      <section class="mb-16">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-8 flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-red-100 text-red-700 flex items-center justify-center font-black">3</span>
          Background Scientifico: Come funziona?
        </h2>
        <div class="bg-white rounded-3xl p-4 md:p-8 border border-slate-100 shadow-sm">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {posLeitourgeiPages.map(page => (
              <a href={`/it/rtms/${page.id.replace('it/', '')}`} class="flex items-center gap-4 p-4 rounded-xl hover:bg-red-50 transition-colors border border-transparent hover:border-red-100 group">
                <div class="w-2 h-2 rounded-full bg-red-400 group-hover:scale-150 transition-transform"></div>
                <span class="text-slate-700 font-bold group-hover:text-red-800">{page.data.title}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="mb-8 bg-white rounded-3xl p-8 md:p-14 shadow-sm border border-slate-100">
        <h2 class="text-3xl font-extrabold text-slate-900 mb-8 tracking-tight">
          Domande Frequenti sulla rTMS
        </h2>
        
        <div class="space-y-4 max-w-4xl">
          <details class="group border border-slate-100 rounded-2xl bg-slate-50/50 p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-300">
            <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-700 transition-colors">
                Cos'è la rTMS?
              </h3>
              <span class="ml-1.5 flex-shrink-0 rounded-full bg-white p-1.5 text-slate-900 shadow-sm transition-transform duration-300 group-open:-rotate-180">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 leading-relaxed text-slate-700 font-light">
              <p>
                La rTMS è una terapia di neuromodulazione non invasiva che utilizza impulsi magnetici per stimolare in modo mirato aree specifiche del cervello. Non richiede anestesia e il paziente rimane cosciente durante la sessione.
              </p>
              <p class="mt-3">
                <a href="/it/rtms/core/ti-einai" class="inline-flex items-center text-sm font-semibold text-red-600 hover:text-red-700 gap-1">
                  Scopri di più: Cos'è la rTMS e l'iTBS &rarr;
                </a>
              </p>
            </div>
          </details>

          <details class="group border border-slate-100 rounded-2xl bg-slate-50/50 p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-300">
            <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-700 transition-colors">
                Qual è la differenza tra rTMS ed ECT?
              </h3>
              <span class="ml-1.5 flex-shrink-0 rounded-full bg-white p-1.5 text-slate-900 shadow-sm transition-transform duration-300 group-open:-rotate-180">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 leading-relaxed text-slate-700 font-light">
              <p>
                La rTMS non è l'elettroshock (terapia elettroconvulsivante). Non provoca convulsioni, non richiede anestesia generale e non è associata alla stessa procedura o al profilo di effetti collaterali cognitivi che l'ECT può presentare.
              </p>
              <p class="mt-3">
                <a href="/it/rtms/core/asfaleia-parenergeies" class="inline-flex items-center text-sm font-semibold text-red-600 hover:text-red-700 gap-1">
                  Scopri di più: Sicurezza ed effetti collaterali &rarr;
                </a>
              </p>
            </div>
          </details>

          <details class="group border border-slate-100 rounded-2xl bg-slate-50/50 p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-300">
            <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-700 transition-colors">
                Qual è la differenza tra rTMS e iTBS?
              </h3>
              <span class="ml-1.5 flex-shrink-0 rounded-full bg-white p-1.5 text-slate-900 shadow-sm transition-transform duration-300 group-open:-rotate-180">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 leading-relaxed text-slate-700 font-light">
              <p>
                L'iTBS è un protocollo di stimolazione magnetica specifico e più breve, appartenente alla famiglia delle terapie TMS. La scelta tra rTMS e iTBS viene effettuata in base all'indicazione, all'anamnesi, alla tollerabilità e alla valutazione clinica.
              </p>
              <p class="mt-3">
                <a href="/it/rtms/core/ti-einai" class="inline-flex items-center text-sm font-semibold text-red-600 hover:text-red-700 gap-1">
                  Scopri di più: Cos'è la rTMS e l'iTBS &rarr;
                </a>
              </p>
            </div>
          </details>

          <details class="group border border-slate-100 rounded-2xl bg-slate-50/50 p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-300">
            <summary class="flex items-center justify-between cursor-pointer focus:outline-none">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-700 transition-colors">
                Quando si consiglia la rTMS per la depressione?
              </h3>
              <span class="ml-1.5 flex-shrink-0 rounded-full bg-white p-1.5 text-slate-900 shadow-sm transition-transform duration-300 group-open:-rotate-180">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 leading-relaxed text-slate-700 font-light">
              <p>
                La rTMS viene presa in considerazione principalmente quando la depressione non ha risposto adeguatamente ai precedenti tentativi di trattamento o quando la terapia farmacologica causa problemi di tollerabilità. L'indicazione viene stabilita a seguito di una valutazione psichiatrica e di un esame dell'anamnesi clinica.
