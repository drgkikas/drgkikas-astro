---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/UI/Header.astro';
import Footer from '../../../components/UI/Footer.astro';

const allRtmsPages = await getCollection('rtms', ({ id }) => {
  return id.startsWith('it/');
});

// Categorize pages based on their directory/id
const corePages = allRtmsPages.filter(p => p.id.startsWith('it/core/')).sort((a,b)=> (a.data.order||0) - (b.data.order||0));
const endixeisPages = allRtmsPages.filter(p => p.id.startsWith('it/endixeis/')).sort((a,b)=> (a.data.order||0) - (b.data.order||0));
const posLeitourgeiPages = allRtmsPages.filter(p => p.id.startsWith('it/pos-leitourgei/')).sort((a,b)=> (a.data.order||0) - (b.data.order||0));
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://drgkikas.com/it/rtms/#webpage",
      "url": "https://drgkikas.com/it/rtms",
      "name": "rTMS Atene | Depressione, DOC e Dipendenza da Cocaina | drGkikas",
      "description": "La terapia rTMS è non invasiva, senza anestesia ed è utilizzata per la depressione resistente, il DOC e la dipendenza da cocaina. Scopri come viene applicata ad Atene, la durata, la sicurezza, gli effetti collaterali e il processo di valutazione.",
      "inLanguage": "it"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://drgkikas.com/it/rtms/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://drgkikas.com/it/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "rTMS",
          "item": "https://drgkikas.com/it/rtms"
        }
      ]
    },
    {
      "@type": "Physician",
      "@id": "https://drgkikas.com/#physician",
      "name": "Paschalis Gkikas",
      "alternateName": "drGkikas",
      "medicalSpecialty": "Psychiatry",
      "image": "https://drgkikas.com/images/dr-gkikas-portrait.jpg",
      "logo": "https://drgkikas.com/images/dr-gkikas-portrait.jpg",
      "url": "https://drgkikas.com/it/",
      "availableLanguage": ["Greek", "English", "Italian"]
    },
    {
      "@type": "MedicalBusiness",
      "@id": "https://drgkikas.com/#clinic",
      "name": "Smart CNS Center",
      "url": "https://drgkikas.com/it/",
      "image": "https://drgkikas.com/images/dr-gkikas-portrait.jpg",
      "logo": "https://drgkikas.com/images/dr-gkikas-portrait.jpg",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Via Xenofontos 15A",
        "addressLocality": "Atene",
        "addressRegion": "Attica",
        "postalCode": "10557",
        "addressCountry": "GR"
      },
      "areaServed": "Athens, Greece"
    },
    {
      "@type": "MedicalTherapy",
      "@id": "https://drgkikas.com/it/rtms/#medicaltherapy",
      "name": "rTMS treatment",
      "alternateName": "Repetitive Transcranial Magnetic Stimulation",
      "url": "https://drgkikas.com/it/rtms",
      "provider": {
        "@id": "https://drgkikas.com/#physician"
      },
      "description": "Terapia di neuromodulazione non invasiva.",
      "clinicalPharmacology": "Transcranial magnetic stimulation",
      "indication": [
        {
          "@type": "MedicalIndication",
          "name": "Treatment-resistant depression"
        },
        {
          "@type": "MedicalIndication",
          "name": "Obsessive-compulsive disorder"
        },
        {
          "@type": "MedicalIndication",
